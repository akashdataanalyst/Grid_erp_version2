 "fields": [
  {
   "fieldname": "assessment_defaults_section",
   "fieldtype": "Section Break",
   "label": "Assessment Defaults"
  },
  {
   "fieldname": "default_assessment_template",
   "fieldtype": "Link",
   "label": "Default Assessment Template",
   "options": "Assessment Template",
   "description": "Used when a Job Opening has no Assessment Template of its own (e.g. General Video Introduction)."
  },
  {
   "fieldname": "auto_assign_on_shortlist",
   "fieldtype": "Check",
   "label": "Auto-send Assessment on Shortlist",
   "default": "1",
   "description": "When a Job Applicant is marked Shortlisted, the assessment (Job Opening template, else the default above) is assigned and emailed automatically. HR can still assign any template manually from Job Applicant > Assessment > Assign Assessment."
  },
  {
   "fieldname": "portal_base_url",
   "fieldtype": "Data",
   "label": "Portal Base URL",
   "description": "Base address put in candidate links, e.g. https://careers.yourcompany.com. Must be HTTPS (or localhost for testing), otherwise browsers block the camera. Empty = site URL."
  },
  {
   "fieldname": "ai_section",
   "fieldtype": "Section Break",
   "label": "AI Evaluation Settings"
  },
  {
   "fieldname": "openai_api_key",
   "fieldtype": "Password",
   "label": "OpenAI API Key",
   "description": "Get your API key from https://platform.openai.com/api-keys"
  },
  {
   "fieldname": "ai_model",
   "fieldtype": "Select",
   "label": "AI Model",
   "options": "gpt-4o-mini\ngpt-4o\ngpt-3.5-turbo",
   "default": "gpt-4o-mini"
  },
  {
   "fieldname": "certificate_section",
   "fieldtype": "Section Break",
   "label": "Certificate Settings"
  },
