   "label": "Certificate Logo"
  },
  {
   "fieldname": "certificate_footer_text",
   "fieldtype": "Small Text",
   "label": "Certificate Footer Text",
   "default": "This certificate is awarded upon successful completion of the recruitment assessment."
  },
  {
   "fieldname": "whatsapp_section",
